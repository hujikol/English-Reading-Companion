{
  "name": "english-reading-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run offline:inventory",
    "offline:inventory": "vite-node src/pwa/offline-assets.build.ts inventory",
    "offline:smoke": "vite-node src/pwa/offline-assets.build.ts smoke",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sample:epub": "vite-node scripts/sample/make-sample-epub.ts",
    "sample:pdf": "vite-node scripts/sample/make-sample-pdf.ts"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector-wasm": "^1.25.2",
    "@mlc-ai/web-llm": "^0.2.85",
    "dexie": "^4.0.10",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
